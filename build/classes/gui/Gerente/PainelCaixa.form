                  <AuxValues>
                    <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="String[] colunas = {&#xa;    &quot;Id Pedido&quot;,&#xa;    &quot;Cliente&quot;,&#xa;    &quot;Valor&quot;,&#xa;    &quot;Status&quot;,&#xa;    &quot;M&#xe9;todo&quot;,&#xa;    &quot;Pagamento&quot;&#xa;};&#xa;&#xa;DefaultTableModel modelo = new DefaultTableModel(colunas, 0);&#xa;&#xa;PedidoDAO dao = new PedidoDAO();&#xa;ArrayList&lt;Pedido&gt; lista = dao.listarPedidosCaixa();&#xa;&#xa;for (Pedido p : lista) {&#xa;&#xa;    modelo.addRow(new Object[]{&#xa;        p.getId(),&#xa;        p.getNomeCliente(),&#xa;        p.getTotal(),&#xa;        p.getStatus(),&#xa;        p.getMetodoPagamento(),&#xa;        p.getStatusPagamento()&#xa;    });&#xa;}"/>
                  </AuxValues>
