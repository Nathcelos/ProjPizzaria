                  <AuxValues>
                    <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="String[] colunas = {&#xa;    &quot;Id&quot;,&#xa;    &quot;Cliente&quot;,&#xa;    &quot;Endere&#xe7;o&quot;,&#xa;    &quot;Status&quot;&#xa;};&#xa;&#xa;DefaultTableModel tabelaModelo =&#xa;        new DefaultTableModel(colunas, 0);&#xa;&#xa;PedidoDAO dao = new PedidoDAO();&#xa;&#xa;ArrayList&lt;Pedido&gt; lista =&#xa;        dao.listarEntregas();&#xa;&#xa;for (Pedido p : lista) {&#xa;&#xa;    Object[] linha = {&#xa;        p.getId(),&#xa;        p.getNomeCliente(),&#xa;        p.getEndereco(),&#xa;        p.getStatus()&#xa;    };&#xa;&#xa;    tabelaModelo.addRow(linha);&#xa;}"/>
                  </AuxValues>
