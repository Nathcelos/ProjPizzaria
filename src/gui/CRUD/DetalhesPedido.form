                              <AuxValues>
                                <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="String[] colunas = {&quot;Item&quot;, &quot;Quantidade&quot;};&#xa;&#xa;DefaultTableModel model =&#xa;        new DefaultTableModel(colunas, 0);&#xa;&#xa;PedidoDAO dao = new PedidoDAO();&#xa;&#xa;int idPedido = Integer.parseInt(txtId.getText());&#xa;&#xa;Pedido p = dao.buscarDetalhesPedido(idPedido);&#xa;&#xa;for (ItensPedido i : p.getItensDetalhados()) {&#xa;&#xa;    model.addRow(new Object[]{&#xa;        i.getNomeProduto(),&#xa;        i.getQuantidade()&#xa;    });&#xa;}"/>
                              </AuxValues>
                            </Component>
                          </SubComponents>
