                  <AuxValues>
                    <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="String[] colunas = {&quot;Id&quot;, &quot;id Cliente&quot;,&quot;Id Funcion&#xe1;rio&quot;, &quot;Data&quot;,&quot;Hora&quot;,&quot;Status&quot;};&#xa;    DefaultTableModel tabelaModelo = new DefaultTableModel (colunas, 0);&#xa;&#xa;    PedidoDAO p = new PedidoDAO();&#xa;    ArrayList&lt;Pedido&gt; lista = p.listaPedido();&#xa;&#xa;    for (int i = 0; i&lt;lista.size(); i++){&#xa;&#xa;        Pedido consultaAtual = lista.get(i);&#xa;&#xa;        String[] linha = {&#xa;            String.valueOf(consultaAtual.getId()),&#xa;            String.valueOf(consultaAtual.getIdFuncionario()),&#xa;            consultaAtual.getData(),&#xa;            consultaAtual.getHora(),&#xa;            consultaAtual.getStatus(),&#xa;        };&#xa;&#xa;        tabelaModelo.addRow(linha);&#xa;    }"/>
                  </AuxValues>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
